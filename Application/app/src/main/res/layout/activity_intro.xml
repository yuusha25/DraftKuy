<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03142c"
    android:paddingBottom="48dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo App -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo DraftKuy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="30dp"/>

        <!-- Gambar Tutorial -->
        <ImageView
            android:id="@+id/ivTutorial"
            android:layout_width="382dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/tutorial_floating"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toBottomOf="@id/logoImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- Gambar Petunjuk -->
        <ImageView
            android:id="@+id/ivPetunjuk"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:src="@drawable/pict_2"
            android:contentDescription="Petunjuk Gambar"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/ivTutorial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- Tombol Mulai -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:backgroundTint="#FFC107"
            android:minWidth="200dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="MULAI DRAFTKUY"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPetunjuk"
            app:layout_constraintVertical_bias="0.529" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
